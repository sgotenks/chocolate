  "components": [
    {
      "name": "Gold Button",
      "kind": "button",
      "refersTo": "button-gold",
      "description": "Primary CTA: foil-gradient pill with noise and hover light sweep.",
      "html": "<a class=\"gold-button\"><span>Explore the Wonka Range</span></a>",
      "css": ".gold-button{display:inline-flex;align-items:center;height:64px;padding:20px 40px;border-radius:70px;font:700 20px/1 Inter,sans-serif;color:#3d2507;border:1px solid transparent;background-image:linear-gradient(90deg,#ad8544,#f8e999 52.88%,#ac8543),linear-gradient(90deg,#cdab63,#f8e59c 19.03%,#b58f4f 46.15%,#f7e498 77.99%,#d8b97d 98.56%);background-origin:border-box;background-clip:padding-box,border-box;position:relative;overflow:hidden}"
    },
    {
      "name": "Glass Button",
      "kind": "button",
      "refersTo": "button-glass",
      "description": "Secondary CTA / nav: frosted white-10 pill.",
      "html": "<a class=\"glass-button\">Scroll Down</a>",
      "css": ".glass-button{padding:20px 32px;border-radius:160px;background:rgba(255,255,255,.1);border:1px solid rgba(255,255,255,.1);color:#fff;font:700 16px/1 Inter,sans-serif;backdrop-filter:blur(16px);transition:background-color .3s ease-out}.glass-button:hover{background:rgba(255,255,255,.3)}"
    },
    {
      "name": "Promo Button",
      "kind": "button",
      "refersTo": "button-promo",
      "description": "Golden-ticket microsite CTA.",
      "html": "<a class=\"promo-button\">Get Started</a>",
      "css": ".promo-button{background:#eec60d;color:#29144e;border-radius:84px;padding:17px 28px;box-shadow:0 4px 0 0 #980186;font-family:\"Work Sans\",sans-serif;font-weight:700}"
    }
  ],
  "narrative": {
    "northStar": "A purple-and-gold confectionery wonderland",
